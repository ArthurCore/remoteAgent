    "title": "Chat Sync API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/channels/{channel_id}/sync/events": {
      "get": {
        "operationId": "getChannelSyncDeltaV1",
        "parameters": [
          {
            "$ref": "#/components/parameters/ChannelId"
          },
          {
            "in": "query",
            "name": "after",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CursorV1"
            }
          },
          {
            "in": "query",
            "name": "through",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CursorV1"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeltaResponseV1"
                }
              }
            },
            "description": "Ascending, fixed-bound delta page"
          },
          "400": {
            "$ref": "#/components/responses/SyncErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/SyncErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/SyncErrorResponse"
          },
          "410": {
            "$ref": "#/components/responses/SyncErrorResponse"
          },
          "503": {
            "$ref": "#/components/responses/SyncErrorResponse"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    }
  },
  "x-agent-workspace-artifact-scope": "sync-v1-concrete-core",
  "x-agent-workspace-blocked-operations": [
